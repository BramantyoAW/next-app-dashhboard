# Node 20 is EOL (2026-04-30) and gets no security releases. 24.22.1 carries the
# 21 Oct 2026 fixes (CVE-2026-111497 Brotli RCE, CVE-2026-105482/105483/106069).
FROM node:24.22.1-bookworm

WORKDIR /app

# install deps
COPY package.json package-lock.json ./
RUN npm ci

# copy source
COPY . .

# ===== BUILD ENV =====

ARG NEXT_PUBLIC_BACKEND_BASE
ARG NEXT_PUBLIC_GRAPHQL_URL
ARG GRAPHQL_URL
ARG WWEBJS_URL
ARG NEXT_PUBLIC_BAILEYS_URL
ARG NEXT_PUBLIC_MAIN_DOMAIN

ENV NEXT_PUBLIC_BACKEND_BASE=$NEXT_PUBLIC_BACKEND_BASE
ENV NEXT_PUBLIC_GRAPHQL_URL=$NEXT_PUBLIC_GRAPHQL_URL
ENV GRAPHQL_URL=$GRAPHQL_URL
ENV WWEBJS_URL=$WWEBJS_URL
ENV NEXT_PUBLIC_BAILEYS_URL=$NEXT_PUBLIC_BAILEYS_URL
ENV NEXT_PUBLIC_MAIN_DOMAIN=$NEXT_PUBLIC_MAIN_DOMAIN

# build next
RUN npm run build

# remove dev deps
RUN npm prune --production

EXPOSE 3000

CMD ["npm", "run", "start"]